# Signs the Flutter-configured iOS build and uploads it to TestFlight.
# Run by .github/workflows/release.yml after `flutter build ios --config-only`.
# Setup and secrets: docs/releasing.md.

opt_out_usage
default_platform(:ios)

APP_ID = "com.abelshiferaw.bodycomp"
SCHEME = "production"
CONFIGURATION = "Release-production"

platform :ios do
  desc "Sign the production flavor and upload it to TestFlight"
  lane :beta do
    setup_ci # temporary keychain on CI, no-op locally
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Downloads the App Store profile for the certificate, or creates it.
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, team_id: team_id)
    profile = lane_context[SharedValues::SIGH_NAME]

    # Manual signing for the CI build only; the committed project stays on automatic signing.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["Runner"],
      build_configurations: [CONFIGURATION],
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: APP_ID
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      export_options: { provisioningProfiles: { APP_ID => profile } },
      output_directory: "../build/ios/ipa"
    )

    # TESTFLIGHT_GROUPS: comma-separated external groups (e.g. the public-link group).
    # Empty means internal testers only, which needs no Beta App Review.
    groups = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    upload_to_testflight(
      api_key: api_key,
      changelog: ENV.fetch("RELEASE_NOTES", "").empty? ? "New beta build" : ENV["RELEASE_NOTES"],
      uses_non_exempt_encryption: false,
      distribute_external: !groups.empty?,
      groups: groups.empty? ? nil : groups,
      skip_waiting_for_build_processing: groups.empty?
    )
  end
end
